<Window x:Class="Bridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天桥" Width="820" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="设置…" Padding="12,4" Click="Settings_Click" VerticalAlignment="Top" />
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,4,0,8" Foreground="#666" TextWrapping="Wrap"
                   Text="微信里多选消息 → 转发 → 转发到其他应用 → 选择电脑中的应用 → 选本程序。也可以把微信导出的 ZIP 拖进这个窗口。" />

        <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,10" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="ConfigLine" TextWrapping="Wrap" />
        </Border>

        <ListView x:Name="Records" Grid.Row="3" SelectionChanged="Records_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="120" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="聊天" Width="130" DisplayMemberBinding="{Binding Chat}" />
                    <GridViewColumn Header="条数" Width="50" DisplayMemberBinding="{Binding Count}" />
                    <GridViewColumn Header="目标" Width="80" DisplayMemberBinding="{Binding Target}" />
                    <GridViewColumn Header="结果" Width="80" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="说明" Width="320" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Expander Grid.Row="4" Header="微信菜单注册状态" Margin="0,10,0,0" Expanded="RegistrationExpanded">
            <StackPanel>
                <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei UI" Background="#FAFAFA" BorderBrush="#DDD" Padding="8" Margin="0,6,0,6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="解除注册" Padding="12,4" Margin="0,0,8,0" Click="Unregister_Click" />
                    <Button Content="注册到微信菜单" Padding="12,4" Click="Register_Click" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="打开数据目录" Padding="12,4" Margin="0,0,8,0" Click="OpenData_Click" />
            <Button Content="刷新" Padding="12,4" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button x:Name="RetryButton" Content="重试所选" Padding="12,4" IsEnabled="False" Click="Retry_Click" />
        </StackPanel>
    </Grid>
</Window>
