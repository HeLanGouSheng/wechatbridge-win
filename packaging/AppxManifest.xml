<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity package ("package with external location"): carries the app's identity and its share-target
  registration; the binaries stay in the folder given to  WeChatBridge.exe -register . Publisher must be
  the signing certificate's Subject byte for byte; Name / Publisher / Application Id must match
  src/Bridge.App/app.manifest and Bridge.Core.BridgeIdentity (a test checks that).
  __VERSION__ is filled in by scripts/build-package.ps1.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="WeChatBridgeWin" Publisher="CN=WeChatBridgeWin" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>微信桥</DisplayName>
    <PublisherDisplayName>微信桥</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="WeChatBridge" Executable="WeChatBridge.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="微信桥"
        Description="把微信转发出来的聊天记录送到 llmsocial 和 AI 应用"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="转发到微信桥">
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <!--__ANYFILE__-->
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
