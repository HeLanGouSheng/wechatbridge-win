<Window x:Class="Bridge.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天桥" Width="760" Height="540" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Grid.Row="1" Margin="0,4,0,12" Foreground="#666" TextWrapping="Wrap" />

        <ListView x:Name="Messages" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="130" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="发送者" Width="120" DisplayMemberBinding="{Binding Sender}" />
                    <GridViewColumn Header="内容" Width="440" DisplayMemberBinding="{Binding Text}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" x:Name="DeliveryPanel" Margin="0,12,0,0" Padding="10,8" Background="#F3F7F3" BorderBrush="#CFE3CF" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <TextBlock x:Name="DeliveryText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenFolder" Content="打开批次目录" Padding="12,4" Margin="0,0,8,0" Click="OpenFolder_Click" />
            <Button x:Name="CopyButton" Content="复制到剪贴板" Padding="12,4" Margin="0,0,8,0" Click="Copy_Click" />
            <Button x:Name="SendButton" Content="发给 llmsocial" Padding="12,4" Margin="0,0,8,0" Click="Send_Click" />
            <Button x:Name="CloseButton" Content="关闭" Padding="12,4" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
