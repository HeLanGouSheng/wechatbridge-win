<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Must equal the Executable= in packaging/AppxManifest.xml (a test checks it). -->
    <AssemblyName>WeChatBridge</AssemblyName>
    <RootNamespace>Bridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App.xaml stays for resources; Program.Main decides between CLI, share activation and the window. -->
    <StartupObject>Bridge.App.Program</StartupObject>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs sit beside the exe: an activated share target must not pay for a %TEMP% extraction. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Allow unsafe-free P/Invoke declarations without the LibraryImport analyzer turning them into errors. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge.Core\Bridge.Core.csproj" />
  </ItemGroup>

</Project>
