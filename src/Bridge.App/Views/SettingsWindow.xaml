<Window x:Class="Bridge.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,8" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="4,3" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="4,3" />
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Text="llmsocial 账号" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="llmsocial 地址" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BaseUrl" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="账号 ID" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AccountId" ToolTip="llmsocial 账号卡片上 acct_ 开头的那串" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="共享密钥" />
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="Secret" />

        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#666" FontSize="12" Margin="0,-4,0,10" TextWrapping="Wrap"
                   Text="在 llmsocial 里新建一个「通用 Webhook」账号（平台选微信，出站地址留空），把它的账号 ID 和共享密钥填到这里。密钥留空表示不改。" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="我的昵称" VerticalAlignment="Top" Margin="0,4,12,8" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="MyNames" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto"
                 ToolTip="微信里你自己显示的昵称，一行一个。用来分辨哪些消息是你发的。" />

        <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#666" FontSize="12" Margin="0,-4,0,10" TextWrapping="Wrap"
                   Text="微信导出的记录只有昵称。填上你自己的昵称，你发的消息才会记成「我方」；改过昵称的每个都填一行。" />

        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="AutoMode" Margin="0,0,0,8" Content="收到转发后直接发给 llmsocial，不弹确认窗口" />

        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="记录保留" Margin="0,0,8,0" />
            <TextBox x:Name="HistoryDays" Width="48" Margin="0" TextAlignment="Center" />
            <TextBlock Text="天（0 = 永久）" Margin="8,0,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock x:Name="Status" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="测试连接" Padding="12,4" Margin="0,0,8,0" Click="Test_Click" />
                <Button x:Name="SaveButton" Content="保存" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
                <Button Content="取消" Padding="12,4" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
